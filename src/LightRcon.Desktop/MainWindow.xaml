<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:LightRcon.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LightRcon.Desktop.MainWindow" Style="{StaticResource {x:Type Window}}" Title="LightRcon+" Width="1440" Height="920" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" Deactivated="Window_Deactivated">
  <Window.Resources>
    <loc:TeamHeaderConverter x:Key="TeamHeader" />
    <loc:CountryFlagConverter x:Key="CountryFlag" />
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="52" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="1" Margin="18,16,18,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid x:Name="AppSettingsPage" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
          <ListBox x:Name="AppSettingsNavigation" SelectedIndex="0" Background="Transparent" SelectionChanged="AppSettingsNavigation_SelectionChanged">
            <ListBoxItem Content="{loc:Loc Key='General'}" />
            <ListBoxItem Content="{loc:Loc Key='About'}" />
          </ListBox>
        </Border>
        <Grid Grid.Column="1" Margin="24,0,0,0">
          <StackPanel x:Name="AppGeneralPage">
            <TextBlock Text="{loc:Loc Key='General'}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,24" />
            <Grid MaxWidth="700" HorizontalAlignment="Stretch">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{loc:Loc Key='Preferred language'}" />
              <ComboBox x:Name="LanguageSelector" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="LanguageSelector_SelectionChanged">
                <ComboBoxItem Content="English" Tag="en" />
                <ComboBoxItem Content="中文" Tag="zh" />
                <ComboBoxItem Content="Deutsch" Tag="de" />
              </ComboBox>
              <TextBlock Grid.Row="1" Text="{loc:Loc Key='Theme'}" Margin="0,20,0,0" />
              <ComboBox x:Name="ThemeSelector" Grid.Row="1" Grid.Column="1" Margin="0,20,0,0" SelectedValuePath="Tag" SelectionChanged="ThemeSelector_SelectionChanged">
                <ComboBoxItem Content="{loc:Loc Key='Follow System'}" Tag="system" />
                <ComboBoxItem Content="{loc:Loc Key='Light'}" Tag="light" />
                <ComboBoxItem Content="{loc:Loc Key='Dark'}" Tag="dark" />
              </ComboBox>
            </Grid>
            <StackPanel Margin="0,28,0,0" MaxWidth="700" HorizontalAlignment="Stretch">
              <TextBlock Text="{loc:Loc Key='Chat and logs'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
              <DockPanel><TextBox x:Name="ChatLineLimitInput" DockPanel.Dock="Right" Width="210" LostKeyboardFocus="ChatLineLimit_LostFocus" KeyDown="ChatLineLimit_KeyDown"/><TextBlock Text="{loc:Loc Key='Maximum chat lines (100–800)'}"/></DockPanel>
              <TextBlock Text="{loc:Loc Key='Default: 450 lines. This limit affects the display only.'}" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
              <Button x:Name="ClearAllLogsButton" Content="{loc:Loc Key='Clear all logs'}" Click="ClearAllLogs_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/>
              <TextBlock Text="{loc:Loc Key='Plugin import'}" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,16" />
              <DockPanel><ComboBox x:Name="PluginImportPreferenceBox" DockPanel.Dock="Right" Width="260" SelectedValuePath="Tag" SelectionChanged="PluginImportPreference_Changed">
                <ComboBoxItem Content="{loc:Loc Key='Ask every time'}" Tag="ask"/><ComboBoxItem Content="{loc:Loc Key='Keep plugin in its original location'}" Tag="keep"/><ComboBoxItem Content="{loc:Loc Key='Copy to plugin folder'}" Tag="copy"/>
              </ComboBox><TextBlock Text="{loc:Loc Key='Import preference'}"/></DockPanel>
              <TextBlock x:Name="AppPreferenceStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="AppAboutPage" Visibility="Collapsed">
            <TextBlock Text="{loc:Loc Key='About'}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,24" />
            <TextBlock Text="LightRcon+" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Key='A lightweight RCON manager inspired by Procon Frostbite.'}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="Powered by Codex (gpt-6.1-sol)" Margin="0,14,0,0" />
            <TextBlock Text="Author: xXN1ckWa1k3rXx" Margin="0,6,0,0" />
            <TextBlock Text="{loc:Loc Key='Initially created entirely with AI. Maintained and reviewed by xXN1ckWa1k3rXx.'}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="{loc:Loc Key='Licensed under GNU GPL v3.0. Includes data derived from Procon Frostbite; see LICENSE and THIRD-PARTY-NOTICES.md.'}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="{loc:Loc Key='Battlefield and related trademarks belong to Electronic Arts and DICE. Not affiliated with or endorsed by EA, DICE or Procon contributors.'}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="Pre-alpha 1.2" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" />
            <TextBlock Text="C# · WPF · .NET 10" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </Grid>
      </Grid>
      <Grid x:Name="HomePage" Margin="8,4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:Loc Key='Welcome'}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock x:Name="HomeSummary" Grid.Row="1" Margin="0,0,0,16" Foreground="{DynamicResource Muted}" />
        <Grid Grid.Row="2">
          <ListBox x:Name="ServerCards" Background="Transparent" MouseDoubleClick="ServerCards_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource OutlinePanel}" Padding="14,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <DockPanel>
                        <Ellipse DockPanel.Dock="Left" Width="12" Height="12" Fill="{Binding StatusBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding WelcomeTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <TextBlock Text="{Binding Summary}" Margin="21,5,0,0" />
                      <TextBlock Text="{Binding Rotation}" Margin="21,3,0,0" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                      <Button Content="{loc:Loc Key='Open'}" Click="OpenServer_Click" />
                      <Button Content="{loc:Loc Key='Edit'}" Click="EditServer_Click" />
                      <Button Content="{loc:Loc Key='Remove'}" Click="RemoveServer_Click" Style="{StaticResource DangerButton}" Margin="0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyState" Text="{loc:Loc Key='No saved servers. Use Add server to create a connection.'}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Content="{loc:Loc Key='Settings'}" Click="AppSettings_Click" MinWidth="100" />
          <Button x:Name="HomeCreateButton" Content="{loc:Loc Key='Create Connection'}" Click="CreateServer_Click" MinWidth="140" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
      </Grid>
      <Grid x:Name="ServerEditorPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
          <Button DockPanel.Dock="Left" Content="{loc:Loc Key='Back'}" Click="CancelServerEditor_Click" />
          <TextBlock x:Name="ServerEditorTitle" Text="{loc:Loc Key='Add server'}" FontSize="18" FontWeight="SemiBold" />
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Width="530" HorizontalAlignment="Left" Margin="0,0,18,18">
            <TextBlock Text="{loc:Loc Key='Leave the username blank for a direct RCON connection. Enter a username to connect to a Layer.'}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,20" />
            <TextBlock Text="{loc:Loc Key='Server name'}" Margin="0,0,0,6" />
            <TextBox x:Name="EditorName" Margin="0,0,0,16" />
            <TextBlock Text="{loc:Loc Key='IP / hostname:port'}" Margin="0,0,0,6" />
            <TextBox x:Name="EditorEndpoint" Margin="0,0,0,16" />
            <TextBlock Text="{loc:Loc Key='Username'}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,16">
              <TextBox x:Name="EditorUsername" TextChanged="EditorUsername_TextChanged" />
              <TextBlock x:Name="EditorUsernamePlaceholder" Text="{loc:Loc Key='Optional for direct RCON connections'}" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Margin="10,0,0,0" />
            </Grid>
            <TextBlock x:Name="EditorPasswordLabel" Text="{loc:Loc Key='RCON / Layer password'}" Margin="0,0,0,6" />
            <PasswordBox x:Name="EditorPassword" Margin="0,0,0,16" />
            <CheckBox x:Name="EditorAutoLogin" Content="{loc:Loc Key='Auto login'}" IsChecked="True" />
            <TextBlock Text="{loc:Loc Key='Retry failed logins every 20 seconds.'}" Foreground="{DynamicResource Muted}" Margin="0,0,0,16" />
            <Border Visibility="Collapsed" />
            <TextBlock x:Name="EditorError" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="EditorSaveButton" Content="{loc:Loc Key='Save and connect'}" Click="SaveServerEditor_Click" Style="{StaticResource PrimaryButton}" />
              <Button x:Name="EditorCancelButton" Content="{loc:Loc Key='Cancel'}" Click="CancelServerEditor_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="WorkspacePage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="ServerSelector" DisplayMemberPath="ConnectionLabel" SelectionChanged="ServerSelector_SelectionChanged" />
          <Button Grid.Column="1" Content="＋" FontSize="18" Click="CreateServer_Click" ToolTip="{loc:Loc Key='Create Connection'}" Margin="8,0,0,0" Padding="10,3" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel x:Name="ServerActionBar" Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <Button x:Name="ConnectButton" Content="{loc:Loc Key='Connect'}" Click="Connect_Click" />
            <Button Content="{loc:Loc Key='Disconnect'}" Click="Disconnect_Click" />
            <Button Content="{loc:Loc Key='Refresh'}" Click="Refresh_Click" />
            <Button x:Name="RestartButton" ToolTip="{loc:Loc Key='Restart'}" Click="Restart_Click" FontFamily="Segoe MDL2 Assets" Content="" />
            <Button x:Name="NextRoundButton" ToolTip="{loc:Loc Key='Next round'}" Click="NextRound_Click" FontFamily="Segoe MDL2 Assets" Content="" Margin="0" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ServerTitle" Visibility="Collapsed" />
            <TextBlock x:Name="ServerSummary" FontSize="13" TextWrapping="Wrap" />
            <CheckBox x:Name="AutoLoginBox" Content="{loc:Loc Key='Auto login'}" Click="AutoLogin_Click" Visibility="Collapsed" />
          </StackPanel>
        </Grid>
        <Border x:Name="ConnectionBanner" Grid.Row="2" Background="{DynamicResource Warning}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
          <TextBlock x:Name="ConnectionBannerText" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" />
        </Border>
        <TabControl Grid.Row="3" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
          <TabItem Header="{loc:Loc Key='Players'}" Tag="Players">
            <TabControl x:Name="PlayersTabs" SelectionChanged="PlayersTabs_SelectionChanged">
              <TabItem Header="{loc:Loc Key='Players'}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Key='Players'}" Foreground="{DynamicResource Muted}" FontSize="12" />
                    <TextBlock x:Name="PlayerCountText" Grid.Column="1" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" />
                  </Grid>
                  <DataGrid Grid.Row="1" x:Name="PlayersGrid" SelectionChanged="PlayersGrid_SelectionChanged" PreviewMouseLeftButtonDown="PlayersGrid_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="PlayersGrid_PreviewMouseRightButtonDown" BorderBrush="{DynamicResource Line}" BorderThickness="1" RowHeight="28">
                    <DataGrid.RowStyle>
                      <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsAlive}" Value="False"><Setter Property="Background" Value="{DynamicResource DeadPlayer}" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                      <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsAlive}" Value="False"><Setter Property="Background" Value="{DynamicResource DeadPlayer}" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="ID#" Binding="{Binding Id}" Width="48" />
                      <DataGridTemplateColumn Header="Geo" SortMemberPath="Geo" Width="72">
                        <DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="{loc:Loc Key='Geo uses historical offline IP data; country assignments may be outdated.'}"/></Style></DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" ToolTip="{Binding GeoDetails}" VerticalAlignment="Center"><Image Source="{Binding Geo, Converter={StaticResource CountryFlag}}" Width="16" Height="12" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock Text="{Binding Geo}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="{loc:Loc Key='Tags'}" Binding="{Binding Tags}" Width="55" />
                      <DataGridTextColumn Header="{loc:Loc Key='Name'}" Binding="{Binding Name}" Width="*" MinWidth="150" />
                      <DataGridTextColumn Header="{loc:Loc Key='Squad'}" Binding="{Binding SquadName}" Width="90" />
                      <DataGridTextColumn Header="{loc:Loc Key='Kit'}" Binding="{Binding Kit}" Width="60" />
                      <DataGridTextColumn Header="{loc:Loc Key='Play Time'}" Binding="{Binding PlayTime}" Width="85" />
                      <DataGridTextColumn Header="{loc:Loc Key='Score'}" Binding="{Binding Score}" Width="65" />
                      <DataGridTextColumn Header="{loc:Loc Key='Type'}" Binding="{Binding Type}" Width="55" />
                      <DataGridTextColumn Header="{loc:Loc Key='Rank'}" Binding="{Binding Rank}" Width="50" />
                      <DataGridTextColumn Header="K" Binding="{Binding Kills}" Width="42" />
                      <DataGridTextColumn Header="D" Binding="{Binding Deaths}" Width="42" />
                      <DataGridTextColumn Header="KDR" Binding="{Binding Kdr}" Width="55" />
                      <DataGridTextColumn Header="Ping" Binding="{Binding Ping}" Width="55" />
                    </DataGrid.Columns>
                    <DataGrid.GroupStyle>
                      <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                          <DataTemplate>
                            <DockPanel Margin="8,10,8,5">
                              <TextBlock Text="{Binding Converter={StaticResource TeamHeader}}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                              <Border Height="1" Background="{DynamicResource Line}" Margin="12,0,0,0" />
                            </DockPanel>
                          </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                      </GroupStyle>
                    </DataGrid.GroupStyle>
                  </DataGrid>
                  <Border Grid.Row="2" Style="{StaticResource OutlinePanel}" Margin="0,10,0,0" Padding="10">
                    <WrapPanel>
                      <TextBlock Text="{loc:Loc Key='Winning team'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                      <ComboBox x:Name="WinningTeamBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="240" Margin="0,0,12,0"/>
                      <Button x:Name="EndRoundButton" Content="{loc:Loc Key='End round'}" Click="EndRound_Click" Style="{StaticResource DangerButton}" Margin="0"/>
                    </WrapPanel>
                  </Border>
                  <Border Grid.Row="3" x:Name="PlayerActionPanel" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="14" Visibility="Collapsed">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SelectedPlayerName" IsReadOnly="True" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Key='Player actions'}" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" />
                      </Grid>
                      <Grid Margin="0,8,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PlayerIdentity" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,16,0"/>
                        <TextBox x:Name="PlayerConnectionDetails" Grid.Column="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                      </Grid>
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="170" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                          <Label Content="{loc:Loc Key='Provider'}" Target="{Binding ElementName=ActionProvider}" Padding="0,0,0,6" Foreground="{DynamicResource Muted}" />
                          <ComboBox x:Name="ActionProvider" SelectedIndex="0">
                            <ComboBoxItem Content="{loc:Loc Key='Server'}" Tag="Server" />
                            <ComboBoxItem Content="PunkBuster" Tag="PunkBuster" />
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                          <Label Content="{loc:Loc Key='Reason'}" Target="{Binding ElementName=PlayerReason}" Padding="0,0,0,6" Foreground="{DynamicResource Muted}" />
                          <TextBox x:Name="PlayerReason" Text="Admin action" MinHeight="32" MaxLength="80" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <Label Content="{loc:Loc Key='Time'}" Target="{Binding ElementName=BanDurationAmount}" Padding="0,0,0,6" Foreground="{DynamicResource Muted}" />
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="80" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BanDurationAmount" Text="30" MinHeight="32" Margin="0,0,8,0" ToolTip="{loc:Loc Key='Temporary ban duration'}" />
                            <ComboBox x:Name="BanDurationUnit" Grid.Column="1" SelectedIndex="0" ToolTip="{loc:Loc Key='Time unit · Months are 30 days'}" AutomationProperties.Name="{loc:Loc Key='Time unit'}">
                              <ComboBoxItem Content="{loc:Loc Key='Minutes'}" Tag="minutes" />
                              <ComboBoxItem Content="{loc:Loc Key='Hours'}" Tag="hours" />
                              <ComboBoxItem Content="{loc:Loc Key='Days'}" Tag="days" />
                              <ComboBoxItem Content="{loc:Loc Key='Weeks'}" Tag="weeks" />
                              <ComboBoxItem Content="{loc:Loc Key='Months'}" Tag="months" />
                            </ComboBox>
                          </Grid>
                        </StackPanel>
                      </Grid>
                      <WrapPanel>
                        <Button Content="{loc:Loc Key='Kill'}" Click="KillPlayer_Click" />
                        <Button Content="{loc:Loc Key='Kick'}" Click="KickPlayer_Click" />
                        <Button Content="{loc:Loc Key='Temp ban'}" Click="TempBanPlayer_Click" />
                        <Button Content="{loc:Loc Key='Permanent ban'}" Style="{StaticResource DangerButton}" Click="PermanentBanPlayer_Click" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem Header="{loc:Loc Key='Ban List'}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc Key='Clear ban list'}" Style="{StaticResource DangerButton}" Click="ClearBans_Click" />
                    <TextBox x:Name="BanSearch" Width="310" HorizontalAlignment="Left" TextChanged="BanSearch_TextChanged" ToolTip="{loc:Loc Key='Search by name, IP, GUID or reason'}" />
                  </DockPanel>
                  <DataGrid x:Name="BansGrid" Grid.Row="1" PreviewMouseRightButtonDown="BansGrid_RightClick">
                    <DataGrid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{loc:Loc Key='Edit ban duration / reason'}" Click="EditBan_Click" />
                        <MenuItem Header="{loc:Loc Key='Remove ban'}" Click="RemoveBan_Click" />
                      </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" />
                      <DataGridTextColumn Header="{loc:Loc Key='Name'}" Binding="{Binding Name}" Width="110" />
                      <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120" />
                      <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="*" MinWidth="150" />
                      <DataGridTextColumn Header="{loc:Loc Key='Type'}" Binding="{Binding BanType}" Width="80" />
                      <DataGridTextColumn Header="{loc:Loc Key='Remaining'}" Binding="{Binding Remaining}" Width="100" />
                      <DataGridTextColumn Header="{loc:Loc Key='Reason'}" Binding="{Binding Reason}" Width="*" MinWidth="130" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="12">
                    <Expander x:Name="ManualBanPanel" Header="{loc:Loc Key='Manual ban'}" ExpandDirection="Down" IsExpanded="True">
                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                        <Label Content="{loc:Loc Key='Identifier type'}" Target="{Binding ElementName=BanIdType}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" />
                        <ComboBox x:Name="BanIdType" SelectedIndex="0">
                          <ComboBoxItem Content="{loc:Loc Key='guid'}" Tag="guid" />
                          <ComboBoxItem Content="{loc:Loc Key='name'}" Tag="name" />
                          <ComboBoxItem Content="{loc:Loc Key='ip'}" Tag="ip" />
                        </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.ColumnSpan="3">
                        <Label Content="{loc:Loc Key='Identifier'}" Target="{Binding ElementName=BanIdentifier}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" />
                        <TextBox x:Name="BanIdentifier" ToolTip="{loc:Loc Key='GUID / Name / IP'}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Label Content="{loc:Loc Key='Ban type'}" Target="{Binding ElementName=BanDurationType}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" />
                        <ComboBox x:Name="BanDurationType" SelectedIndex="0" SelectionChanged="ManualBanType_SelectionChanged">
                          <ComboBoxItem Content="{loc:Loc Key='perm'}" Tag="perm" />
                          <ComboBoxItem Content="{loc:Loc Key='Temporary ban'}" Tag="seconds" />
                          <ComboBoxItem Content="{loc:Loc Key='rounds'}" Tag="rounds" />
                        </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                        <Label Content="{loc:Loc Key='Duration'}" Target="{Binding ElementName=BanDurationValue}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" />
                        <TextBox x:Name="BanDurationValue" Text="1800" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0">
                        <Label Content="{loc:Loc Key='Time unit'}" Target="{Binding ElementName=ManualBanDurationUnit}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" />
                        <ComboBox x:Name="ManualBanDurationUnit" SelectedIndex="0" IsEnabled="False" ToolTip="{loc:Loc Key='Time unit · Months are 30 days'}">
                          <ComboBoxItem Content="{loc:Loc Key='seconds'}" Tag="seconds" />
                          <ComboBoxItem Content="{loc:Loc Key='Minutes'}" Tag="minutes" />
                          <ComboBoxItem Content="{loc:Loc Key='Hours'}" Tag="hours" />
                          <ComboBoxItem Content="{loc:Loc Key='Days'}" Tag="days" />
                          <ComboBoxItem Content="{loc:Loc Key='Weeks'}" Tag="weeks" />
                          <ComboBoxItem Content="{loc:Loc Key='Months'}" Tag="months" />
                        </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
                        <Label Content="{loc:Loc Key='Reason'}" Target="{Binding ElementName=ManualBanReason}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" />
                        <TextBox x:Name="ManualBanReason" Text="Banned by admin" MaxLength="80" />
                        </StackPanel>
                        <Button Grid.Row="2" Grid.Column="4" x:Name="AddManualBanButton" Content="{loc:Loc Key='Add ban'}" Click="AddBan_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" MinWidth="140" Margin="0" />
                      </Grid>
                    </Expander>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem Header="{loc:Loc Key='Special Slots'}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource Panel}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{loc:Loc Key='Spectator Slots'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <DockPanel Margin="0,0,0,12">
                          <Button DockPanel.Dock="Right" Content="{loc:Loc Key='Add'}" Click="AddSpectator_Click" Margin="8,0,0,0" />
                          <TextBox x:Name="SpectatorName" ToolTip="{loc:Loc Key='Soldier name'}" />
                        </DockPanel>
                      </StackPanel>
                      <Button DockPanel.Dock="Bottom" Content="{loc:Loc Key='Remove selected'}" Click="RemoveSpectator_Click" Margin="0,12,0,0" />
                      <ListBox x:Name="SpectatorList" />
                    </DockPanel>
                  </Border>
                  <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{loc:Loc Key='Reserved Slots'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <DockPanel Margin="0,0,0,12">
                          <Button DockPanel.Dock="Right" Content="{loc:Loc Key='Add'}" Click="AddReserved_Click" Margin="8,0,0,0" />
                          <TextBox x:Name="ReservedName" ToolTip="{loc:Loc Key='Soldier name'}" />
                        </DockPanel>
                      </StackPanel>
                      <Button DockPanel.Dock="Bottom" Content="{loc:Loc Key='Remove selected'}" Click="RemoveReserved_Click" Margin="0,12,0,0" />
                      <ListBox x:Name="ReservedList" />
                    </DockPanel>
                  </Border>
                </Grid>
              </TabItem>
            </TabControl>
          </TabItem>
          <TabItem Header="{loc:Loc Key='Chat'}" Tag="Chat">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Label Content="{loc:Loc Key='Player ID filter'}" Target="{Binding ElementName=ChatPlayerFilter}" VerticalAlignment="Center" Padding="0,0,10,0"/>
                <TextBox x:Name="ChatPlayerFilter" Grid.Column="1" TextChanged="ChatFilter_Changed" ToolTip="{loc:Loc Key='Filter by player name, EA GUID or PB GUID'}"/>
                <CheckBox x:Name="OnlyChatMessagesBox" Grid.Column="2" Content="{loc:Loc Key='Only Chat message'}" Click="ChatFilter_Changed" Margin="16,0,0,0"/>
              </Grid>
              <loc:ActivityEditor Grid.Row="1" x:Name="ChatList" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13" Loaded="LogText_Loaded" />
              <DockPanel Grid.Row="2" Margin="0,8,0,8">
                <Button DockPanel.Dock="Right" x:Name="SendChatButton" Content="{loc:Loc Key='Send'}" Style="{StaticResource PrimaryButton}" Click="SendChat_Click" Margin="8,0,0,0" MinWidth="90" />
                <Button DockPanel.Dock="Right" x:Name="ClearChatButton" Content="{loc:Loc Key='Clear chat'}" Click="ClearChat_Click" Margin="8,0,0,0" />
                <TextBox x:Name="ChatInput" MinHeight="32" KeyDown="ChatInput_KeyDown" />
              </DockPanel>
              <WrapPanel Grid.Row="3">
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="{loc:Loc Key='Display'}" Margin="0,0,0,5" />
                  <ComboBox x:Name="DisplayBox" Width="145" SelectedIndex="0" SelectionChanged="DisplayBox_SelectionChanged">
                    <ComboBoxItem Content="{loc:Loc Key='Say'}" Tag="Say" />
                    <ComboBoxItem Content="{loc:Loc Key='Yell'}" Tag="Yell" />
                  </ComboBox>
                </StackPanel>
                <StackPanel x:Name="YellTimePanel" Margin="0,0,16,0" Visibility="Collapsed">
                  <TextBlock Text="{loc:Loc Key='Duration'}" Margin="0,0,0,5" />
                  <ComboBox x:Name="YellTimeBox" Width="120" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="{loc:Loc Key='Audience'}" Margin="0,0,0,5" />
                  <ComboBox x:Name="AudienceBox" Width="220" />
                </StackPanel>
                <CheckBox x:Name="ShowAdminSayYellBox" Content="{loc:Loc Key='Show admin say/yell'}" ToolTip="{loc:Loc Key='Show Say/Yell sent by plugins. Messages sent from LightRcon+ Chat are always shown.'}" Click="ShowAdminSayYell_Click" VerticalAlignment="Bottom" Margin="0,0,16,8" IsChecked="False"/>
                <TextBlock x:Name="ChatRetentionText" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
              </WrapPanel>
            </Grid>
          </TabItem>
          <TabItem Header="{loc:Loc Key='Map List'}" Tag="Map List">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="{loc:Loc Key='Refresh'}" Click="RefreshMaps_Click" />
                  <Button x:Name="LoadMapListButton" Content="{loc:Loc Key='Load MapList.txt'}" Click="LoadMapList_Click" />
                  <Button Content="{loc:Loc Key='Clear all'}" Style="{StaticResource DangerButton}" Click="ClearMaps_Click" />
                </StackPanel>
                <TextBlock Text="{loc:Loc Key='Map rotation'}" Foreground="{DynamicResource Muted}" FontSize="12" />
              </DockPanel>
              <Border Grid.Row="1" Style="{StaticResource OutlinePanel}" Padding="14">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{loc:Loc Key='Available Maps'}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Key='Expand a map to choose a mode. Drag it to the list or use Add.'}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,12" />
                    <TextBox x:Name="MapSearch" TextChanged="MapSearch_TextChanged" ToolTip="{loc:Loc Key='Search maps or file names'}" Margin="0,0,0,10" />
                  </StackPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Surface}">
                    <ItemsControl x:Name="AvailableMapsList" PreviewMouseMove="AvailableMaps_MouseMove" PreviewMouseLeftButtonDown="MapDrag_MouseDown">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,4,4,14">
                            <DockPanel Margin="0,5,0,8">
                              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                              <Border Background="{DynamicResource Line}" Height="1" Margin="12,0,0,0" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Maps}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Expander Header="{Binding Name}" Background="Transparent" Foreground="{DynamicResource Text}" Margin="4,2,0,2" HorizontalContentAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding Modes}" Margin="24,3,0,5">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="*" MinWidth="130" />
                                              <ColumnDefinition Width="65" />
                                              <ColumnDefinition Width="35" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Foreground="{DynamicResource Text}" />
                                            <ComboBox Grid.Column="1" Width="60" ItemsSource="{Binding RoundChoices}" SelectedItem="{Binding Rounds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Key='Rounds'}" />
                                            <Button Grid.Column="2" Content="+" Padding="6,3" Margin="5,0,0,0" Click="AddMap_Click" ToolTip="{loc:Loc Key='Add'}" />
                                          </Grid>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </Expander>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource OutlinePanel}" Padding="14">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{loc:Loc Key='Current map list'}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Key='Drag to reorder; changes save to the server MapList.txt. Double-click a map to switch now.'}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,12" />
                  </StackPanel>
                  <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="↑" Click="MapUp_Click" />
                    <Button Content="↓" Click="MapDown_Click" />
                    <Button Content="{loc:Loc Key='Remove'}" Click="RemoveMap_Click" />
                    <Button Content="{loc:Loc Key='Set as next map'}" Click="SetNextMap_Click" />
                  </WrapPanel>
                  <ListBox x:Name="CurrentMapsList" AllowDrop="True" DragOver="CurrentMaps_DragOver" DragLeave="CurrentMaps_DragLeave" Drop="CurrentMaps_Drop" PreviewMouseMove="CurrentMaps_MouseMove" PreviewMouseLeftButtonDown="MapDrag_MouseDown" MouseDoubleClick="CurrentMaps_MouseDoubleClick" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,5">
                          <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" />
                          <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="{loc:Loc Key='Server Settings'}" Tag="Server Settings">
            <TabControl x:Name="ServerSettingsTabs" SelectionChanged="ServerSettingsTabs_SelectionChanged">
              <TabItem Header="{loc:Loc Key='General'}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ListBox x:Name="SettingsNavigation" SelectionChanged="SettingsNavigation_SelectionChanged" Background="Transparent" />
                  <ScrollViewer x:Name="SettingsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" ScrollChanged="SettingsScroll_ScrollChanged">
                    <StackPanel x:Name="SettingsSections" />
                  </ScrollViewer>
                  <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="{loc:Loc Key='Local settings take priority. Offline changes sync after reconnecting.'}" Style="{StaticResource MutedText}" FontSize="11" />
                  </DockPanel>
                </Grid>
              </TabItem>
              <TabItem Header="{loc:Loc Key='Startup Config'}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="{loc:Loc Key='Export Startup.txt'}" Click="ExportConfig_Click" />
                    <Button Content="{loc:Loc Key='Export MapList.txt'}" Click="ExportMapList_Click" />
                  </StackPanel>
                  <TextBox x:Name="StartupConfigText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
              </TabItem>
            </TabControl>
          </TabItem>
          <TabItem Header="{loc:Loc Key='Console'}" Tag="Console">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,12">
                <TextBlock Text="{loc:Loc Key='Console'}" FontSize="12" Foreground="{DynamicResource Muted}" />
                <ComboBox x:Name="ConsoleFilter" Width="140" DockPanel.Dock="Right" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="ConsoleFilter_SelectionChanged">
                  <ComboBoxItem Content="{loc:Loc Key='All'}" Tag="All" />
                  <ComboBoxItem Content="RCON" Tag="RCON" />
                  <ComboBoxItem Content="PunkBuster" Tag="PunkBuster" />
                  <ComboBoxItem Content="Layer" Tag="Layer" />
                </ComboBox>
              </DockPanel>
              <TextBox Grid.Row="1" x:Name="ConsoleList" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" Loaded="LogText_Loaded" />
              <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="{loc:Loc Key='Execute'}" Click="SendConsole_Click" Margin="10,0,0,0" />
                <TextBox x:Name="ConsoleInput" KeyDown="ConsoleInput_KeyDown" ToolTip="{loc:Loc Key='For example: serverInfo or punkBuster.pb_sv_command &quot;pb_sv_plist&quot;'}" FontFamily="Consolas" />
              </DockPanel>
            </Grid>
          </TabItem>
          <TabItem Header="{loc:Loc Key='Layers'}" Tag="Layers" x:Name="LayersTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,16" x:Name="LayerListenerPanel">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{loc:Loc Key='Layer listener'}" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock x:Name="LayerHostStatus" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock Text="{loc:Loc Key='TLS encryption, separate accounts and server-side permissions. Chat and events are saved locally while enabled.'}" Style="{StaticResource MutedText}" Margin="0,9,0,16" />
                    <WrapPanel>
                      <TextBlock Text="{loc:Loc Key='Bind IP'}" Margin="0,0,8,0" />
                      <TextBox x:Name="LayerBind" Text="0.0.0.0" Width="150" Margin="0,0,14,0" />
                      <TextBlock Text="{loc:Loc Key='Port'}" Margin="0,0,8,0" />
                      <TextBox x:Name="LayerPort" Text="47300" Width="85" Margin="0,0,14,0" />
                      <Button x:Name="EnableLayerButton" Content="{loc:Loc Key='Enable Layer'}" Click="EnableLayer_Click" Style="{StaticResource PrimaryButton}" />
                      <Button x:Name="DisableLayerButton" Content="{loc:Loc Key='Disable Layer'}" Click="DisableLayer_Click" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="{loc:Loc Key='Refresh accounts'}" Click="RefreshLayerAccounts_Click" />
                      <TextBlock Text="{loc:Loc Key='Accounts &amp; permissions'}" FontSize="18" FontWeight="SemiBold" />
                    </DockPanel>
                    <WrapPanel Margin="0,14,0,14">
                      <Button Content="{loc:Loc Key='Global permissions'}" Click="GlobalPermissions_Click" Margin="12,0,8,0" />
                      <Button Content="{loc:Loc Key='Add account'}" Click="AddLayerAccount_Click" />
                      <Button Content="{loc:Loc Key='Edit selected'}" Click="EditLayerAccount_Click" />
                      <Button Content="{loc:Loc Key='Delete selected'}" Style="{StaticResource DangerButton}" Click="DeleteLayerAccount_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="GlobalPermissionsText" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" />
                    <DataGrid x:Name="LayerAccountsGrid" Height="230">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key='Username'}" Binding="{Binding Username}" Width="*" />
                        <DataGridCheckBoxColumn Header="{loc:Loc Key='Enabled'}" Binding="{Binding Enabled}" Width="90" />
                        <DataGridTextColumn Header="{loc:Loc Key='Permissions (blank inherits global)'}" Binding="{Binding Permissions}" Width="2*" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{loc:Loc Key='Account permissions override global defaults. Changing permissions or passwords disconnects existing sessions.'}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Loc Key='Plugin'}" Tag="Plugin">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="0,0,0,12"><Button x:Name="RefreshPluginListButton" DockPanel.Dock="Right" Content="{loc:Loc Key='Refresh list'}" Click="RefreshPluginList_Click" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"/><TextBlock Text="{loc:Loc Key='Plugins'}" FontSize="18" FontWeight="SemiBold" /></DockPanel>
                    <Button x:Name="ImportPluginButton" Content="{loc:Loc Key='Add plugin…'}" Click="ImportPlugin_Click" Margin="0,0,0,8" />
                  </StackPanel>
                  <ListBox x:Name="EnabledPluginList" AllowDrop="True" PreviewDragOver="PluginList_DragOver" Drop="PluginList_Drop" SelectionChanged="PluginSelection_Changed" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                      <DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" /></StackPanel></DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
                <Grid Grid.Column="2">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button x:Name="ReloadPluginSettingsButton" Content="{loc:Loc Key='Reload'}" Click="ReloadPluginSettings_Click" MinHeight="42" Margin="0,0,12,0" />
                        <Button x:Name="EnableSelectedPluginButton" Content="{loc:Loc Key='Enable'}" Click="EnableSelectedPlugin_Click" Style="{StaticResource PrimaryButton}" MinWidth="125" MinHeight="42" FontSize="15" Margin="0" />
                        <Button x:Name="DisableSelectedPluginButton" Content="{loc:Loc Key='Disable'}" Click="DisablePlugin_Click" Style="{StaticResource PrimaryButton}" MinWidth="125" MinHeight="42" FontSize="15" Margin="0" Visibility="Collapsed" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock x:Name="PluginNameText" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PluginPageStatus" Text="{loc:Loc Key='Select a plugin to view its details and settings.'}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Grid.Row="1" x:Name="ProconBanner" Background="#FFE49B" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ProconBannerText" Text="{loc:Loc Key='This plugin is designed for Procon. Compatibility is enabled; stability is not guaranteed.'}" Foreground="#382B00" TextWrapping="Wrap" />
                  </Border>
                  <TabControl x:Name="PluginPages" Grid.Row="2" IsEnabled="False">
                    <TabItem Header="{loc:Loc Key='Details'}">
                      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                        <TextBlock Text="{loc:Loc Key='Version'}" Style="{StaticResource MutedText}" Margin="0,16,0,4" /><TextBlock x:Name="PluginVersionText" />
                        <TextBlock Text="{loc:Loc Key='Author'}" Style="{StaticResource MutedText}" Margin="0,12,0,4" /><TextBlock x:Name="PluginAuthorText" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Loc Key='Website'}" Style="{StaticResource MutedText}" Margin="0,12,0,4" /><TextBlock x:Name="PluginWebsiteText" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Loc Key='Description'}" Style="{StaticResource MutedText}" Margin="0,12,0,4" /><TextBlock x:Name="PluginDescriptionText" TextWrapping="Wrap" />
                        <StackPanel x:Name="PluginPathPanel"><TextBlock Text="{loc:Loc Key='File'}" Style="{StaticResource MutedText}" Margin="0,12,0,4" /><TextBlock x:Name="PluginPathText" TextWrapping="Wrap" /></StackPanel>
                        <TextBlock x:Name="PluginErrorText" TextWrapping="Wrap" Margin="0,16,0,0" />
                      </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="{loc:Loc Key='Plugin Settings'}">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,16,50,16"><StackPanel x:Name="PluginSettingFields" /></ScrollViewer>
                    </TabItem>
                  </TabControl>
                </Grid>
                <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                  <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Key='Plugin console'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                  <loc:PluginConsoleEditor x:Name="PluginConsoleList" Height="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" Loaded="LogText_Loaded"/>
                </DockPanel>
            </Grid>
          </TabItem>
        </TabControl>
        <Grid Grid.Row="3" x:Name="OfflinePanel" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="650" HorizontalAlignment="Left">
              <TextBlock x:Name="OfflineTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10" />
              <TextBlock x:Name="OfflineReason" TextWrapping="Wrap" />
              <TextBlock x:Name="OfflineRetry" Margin="0,8,0,20" Foreground="{DynamicResource Muted}" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="OfflineConnectButton" Content="{loc:Loc Key='Connect'}" Click="Connect_Click" />
                <Button Content="{loc:Loc Key='Disconnect'}" Click="Disconnect_Click" />
              </StackPanel>
              <StackPanel Width="530" HorizontalAlignment="Left" Margin="0,16,0,10">
                <TextBlock Text="{loc:Loc Key='Leave the username blank for a direct RCON connection. Enter a username to connect to a Layer.'}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,20" />
                <TextBlock Text="{loc:Loc Key='Server name'}" Margin="0,0,0,6" />
                <TextBox x:Name="OfflineName" Margin="0,0,0,16" />
                <TextBlock Text="{loc:Loc Key='IP / hostname:port'}" Margin="0,0,0,6" />
                <TextBox x:Name="OfflineEndpoint" Margin="0,0,0,16" />
                <TextBlock Text="{loc:Loc Key='Username'}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                  <TextBox x:Name="OfflineUsername" TextChanged="OfflineUsername_TextChanged" />
                  <TextBlock x:Name="OfflineUsernamePlaceholder" Text="{loc:Loc Key='Optional for direct RCON connections'}" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Margin="10,0,0,0" />
                </Grid>
                <TextBlock x:Name="OfflinePasswordLabel" Text="{loc:Loc Key='RCON / Layer password'}" Margin="0,0,0,6" />
                <PasswordBox x:Name="OfflinePassword" Margin="0,0,0,16" />
                <CheckBox x:Name="OfflineAutoLogin" Content="{loc:Loc Key='Auto login'}" IsChecked="True" />
                <TextBlock Text="{loc:Loc Key='Retry failed logins every 20 seconds.'}" Foreground="{DynamicResource Muted}" Margin="0,0,0,16" />
                <Border Visibility="Collapsed" />
                <TextBlock x:Name="OfflineError" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="OfflineSaveButton" Content="{loc:Loc Key='Save and connect'}" Click="SaveOfflineConnection_Click" Style="{StaticResource PrimaryButton}" />
                  <Button x:Name="OfflineCancelButton" Content="{loc:Loc Key='Cancel'}" Click="ResetOfflineConnection_Click" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
        <DockPanel>
          <TextBlock x:Name="FooterStatus" Text="{loc:Loc Key='Ready'}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>
    </Grid>
    <Border x:Name="SideRail" Grid.ColumnSpan="2" Panel.ZIndex="10" HorizontalAlignment="Left" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" ClipToBounds="True" MouseEnter="Rail_MouseEnter" MouseLeave="Rail_MouseLeave">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="52" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsRailExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="Width" Value="320" />
              <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Width" From="52" To="320" Duration="0:0:0.16" FillBehavior="Stop"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
              <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Width" From="320" To="52" Duration="0:0:0.12" FillBehavior="Stop" /></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel Margin="4,6">
        <Button DockPanel.Dock="Top" x:Name="HomeButton" Click="Home_Click" ToolTip="{loc:Loc Key='Welcome'}" Style="{StaticResource RailButton}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{loc:Loc Key='Welcome'}" Style="{StaticResource RailLabel}" FontSize="16" />
          </Grid>
        </Button>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" Margin="2,6" />
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{DynamicResource Line}" Margin="2,6" />
          <Button x:Name="AppSettingsButton" Click="AppSettings_Click" ToolTip="{loc:Loc Key='Settings'}" Style="{StaticResource RailButton}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{loc:Loc Key='Settings'}" Style="{StaticResource RailLabel}" FontSize="16" />
            </Grid>
          </Button>
          <TextBlock x:Name="SidebarCount" Visibility="Collapsed" />
        </StackPanel>
        <ListBox x:Name="SidebarServers" Background="Transparent" SelectionChanged="SidebarServers_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,5" ToolTip="{Binding ConnectionLabel}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="26" Height="26" HorizontalAlignment="Center">
                  <Path Data="M3,3 L21,3 21,10 3,10 Z M3,13 L21,13 21,20 3,20 Z M6,6.5 L8,6.5 M6,16.5 L8,16.5" Stroke="{DynamicResource Muted}" StrokeThickness="1.3" StrokeLineJoin="Round" />
                  <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Stroke="{DynamicResource Sidebar}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding SidebarLabel}" Style="{StaticResource RailLabel}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</Window>
