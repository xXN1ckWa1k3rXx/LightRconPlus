  "settings_types": [
    "string",
    "multiline",
    "bool",
    "int",
    "double",
    "stringarray",
    "onoff",
    "yesno",
    "enum.Name(Choice1|Choice2)"
  ],
  "limits": {
    "instructions_per_callback": 100000,
    "timers_per_plugin": 128,
    "minimum_timer_seconds": 0.1,
    "http_timeout_seconds": 10,
    "http_response_bytes": 1048576,
    "json_depth": 32
  },
  "array_index_base": 1,
  "protocol_index_base": 0,
  "module_loading": "Built-in namespace modules or local dotted module paths under the plugin directory.",
