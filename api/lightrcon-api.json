{
  "api_version": 1,
  "application_version": "Pre-alpha 1.2",
  "engine": "MoonSharp 2.0.0",
  "entrypoint": "plugin metadata plus event callbacks",
  "reference": "docs/LUA-API.md",
  "namespaces": {
    "admin": [
      "say(scope,text,...)",
      "yell(scope,text,seconds,...)",
      "kick(name,reason)",
      "kill(name)",
      "move(name,team,squad,force)",
      "listPlayers(...)",
      "kickPlayer(...)",
      "killPlayer(...)",
      "movePlayer(...)"
    ],
    "server": [
      "get_info()",
      "get_settings()",
      "is_connected()",
      "get_game()",
      "restart_round()",
      "next_round()"
    ],
    "players": [
      "list()",
      "get(name)",
      "count()"
    ],
    "maps": [
      "list()",
      "add(name,mode,rounds)",
      "remove(index)",
      "clear()",
      "save()",
      "load()",
      "set_next(index)"
    ],
    "bans": [
      "list()",
      "add(id_type,identifier,duration,...)",
      "remove(id_type,identifier)",
      "clear()",
      "save()",
      "load()"
    ],
    "reserved_slots": [
      "list()",
      "add(name)",
      "remove(name)",
      "clear()",
      "save()",
      "load()"
    ],
    "spectators": [
      "list()",
      "add(name)",
      "remove(name)",
      "clear()",
      "save()",
      "load()"
    ],
    "settings": [
      "define(name,type,default_value,read_only)",
      "get(name)"
    ],
    "timer": [
      "after(seconds,callback)",
      "every(seconds,callback)",
      "cancel(id)"
    ],
    "storage": [
      "get(key,default_value)",
      "set(key,value)",
      "remove(key)"
    ],
    "json": [
      "encode(value)",
      "decode(text)"
    ],
    "http": [
      "request(method,url,body,headers)"
    ],
    "log": [
      "info(text)",
      "warning(text)",
      "error(text)",
      "debug(text)"
    ],
    "rcon": [
      "command(command,...)"
    ],
    "procon": [
      "execute_command(command,...)",
      "call(class_name,method,...)"
    ],
    "mapList": [
      "list(...)",
      "availableMaps(...)",
      "getMapIndices(...)",
      "getRounds(...)",
      "add(...)",
      "remove(...)",
      "clear(...)",
      "save(...)",
      "load(...)",
      "setNextMapIndex(...)",
      "restartRound(...)",
      "runNextRound(...)",
      "endRound(...)"
    ],
    "banList": [
      "list(...)",
      "add(...)",
      "remove(...)",
      "clear(...)",
      "save(...)",
      "load(...)"
    ],
    "reservedSlotsList": [
      "list(...)",
      "add(...)",
      "remove(...)",
      "clear(...)",
      "save(...)",
      "aggressiveJoin(...)"
    ],
    "spectatorList": [
      "list(...)",
      "add(...)",
      "remove(...)",
      "clear(...)",
      "save(...)",
      "load(...)"
    ],
    "punkBuster": [
      "isActive(...)",
      "pb_sv_command(...)"
    ],
    "fairFight": [
      "isActive(...)"
    ],
    "player": [
      "isAlive(...)"
    ],
    "vars": [
      "serverName(...)",
      "serverDescription(...)",
      "serverMessage(...)",
      "serverType(...)",
      "maxPlayers(...)",
      "maxSpectators(...)",
      "commander(...)",
      "hacker(...)",
