      "forceReloadWholeMags(...)",
      "unlockMode(...)",
      "gunMasterWeaponsPreset(...)",
      "vehicleSpawnAllowed(...)",
      "vehicleSpawnDelay(...)",
      "3pCam(...)",
      "hud(...)",
      "miniMap(...)",
      "miniMapSpotting(...)",
      "3dSpotting(...)",
      "nameTag(...)",
      "killCam(...)",
      "crossHair(...)",
      "hitIndicatorsEnabled(...)",
      "gameModeCounter(...)",
      "roundTimeLimit(...)",
      "ticketBleedRate(...)",
