      "roundLockdownCountdown(...)",
      "roundWarmupTimeout(...)",
      "idleTimeout(...)",
      "idleBanRounds(...)",
      "teamKillCountForKick(...)",
      "teamKillKickForBan(...)",
      "teamKillValueForKick(...)",
      "teamKillValueIncrease(...)",
      "teamKillValueDecreasePerSecond(...)",
      "premiumStatus(...)",
      "mpExperience(...)",
      "roundPlayersReadyBypassTimer(...)",
      "roundPlayersReadyMinCount(...)",
      "roundPlayersReadyPercent(...)",
      "bannerUrl(...)",
      "ctfRoundTimeModifier(...)",
      "rankLimit(...)",
      "roundStartReadyPlayersNeeded(...)"
    ],
    "event": [
      "on(raw_name,callback)",
      "off(raw_name)"
    ],
    "plugin": []
  },
  "plugin_metadata": [
    "api_version",
    "name",
    "version",
    "author",
    "website",
    "description"
  ],
  "events": [
    "player_respawn",
    "player_join",
    "player_leave",
    "player_chat",
    "player_kill",
    "player_authenticated",
    "player_disconnect",
    "player_team_change",
    "player_squad_change",
    "round_over",
    "level_loaded",
    "level_loading",
    "round_over_players",
    "round_over_team_scores",
    "punkbuster_message",
    "plugin_enable",
    "plugin_disable",
    "setting_changed",
    "raw"
  ],
  "event_registration": [
    "event.<name>:set(callback_or_nil)",
    "event.on(raw_name,callback)",
    "event.off(raw_name)"
  ],
  "player_methods": [
    "get_name()",
    "get_guid()",
    "get_pb_guid()",
    "get_ip()",
    "get_team()",
    "get_squad()",
    "get_kills()",
    "get_deaths()",
    "get_ping()",
    "is_alive()",
    "kick(reason)",
